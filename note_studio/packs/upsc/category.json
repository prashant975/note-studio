{
  "_comment": "Built-in pack for the UPSC engine (engines/upsc), switched on in Phase 5. Subject ids are the engine's own (src/config.py SUBJECT_LABELS); keep them unchanged. 'upsc' is what the old app sends when its subject box is left empty. rules/ starts empty: the engine's prompts already carry the UPSC rules.",
  "id": "upsc",
  "label": "UPSC (OnlyIAS)",
  "enabled": true,
  "builtin": true,
  "order": 3,
  "summary": "Daily class notes and Mains/Prelims notes from a class recording, Mains practice and DPP.",
  "subjects": [
    {"id": "upsc", "label": "Not set (as in the old app)"},
    {"id": "polity", "label": "Polity"},
    {"id": "economy", "label": "Economy"},
    {"id": "geography", "label": "Geography"},
    {"id": "ancient", "label": "Ancient History"},
    {"id": "medieval", "label": "Medieval History"},
    {"id": "modern", "label": "Modern History"},
    {"id": "history", "label": "History (general)"},
    {"id": "culture", "label": "Art & Culture"},
    {"id": "environment", "label": "Environment"},
    {"id": "science", "label": "Science & Tech"},
    {"id": "ir", "label": "International Relations"},
    {"id": "society", "label": "Society"},
    {"id": "security", "label": "Internal Security"},
    {"id": "governance", "label": "Governance"},
    {"id": "ethics", "label": "Ethics (GS4)"},
    {"id": "current_affairs", "label": "Current Affairs"}
  ],
  "subject_auto": false,
  "languages": ["english", "hindi", "marathi"],
  "language_required": true,
  "note_types": ["upsc_dcn", "upsc_simple", "upsc_mains", "upsc_prelims", "upsc_mains_practice", "dpp_from_notes"],
  "default_note_type": "upsc_dcn",
  "inputs": ["video_link", "slides_upload"],
  "branding": {"signature_label": "Faculty", "footer": "PW OnlyIAS | {page} | Daily Class Notes",
               "logo": "the engine's own (engines/upsc/assets/pw_onlyias_logo.png)"},
  "rules_dir": "rules",
  "qc_rules": "the engine's own (engines/upsc/config/upsc_qc_rules.yaml, upsc_qc_sources.yaml)",
  "practice": {
    "dpp_question_bank": "engines/upsc/data/DPP and Infinite Practice Questions.xlsx",
    "dpp_tags": "engines/upsc/data/UPSC QBG Tags.xlsx",
    "dpp_languages": ["english", "hindi"]
  },
  "page_budget": {"target_pages": [10, 15], "hard_limit": 15}
}
