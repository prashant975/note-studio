.venv/
__pycache__/
*.pyc
.env
.streamlit/secrets.toml
runs/
output/
.pytest_cache/
tests/fixtures/
testdata/

# --- credentials: never commit ------------------------------------------
# secrets.toml is listed above; these cover the copies that grow around it.
# A .bak of a secrets file holds exactly the same live credential.
.streamlit/secrets.toml.bak
.streamlit/secrets*.toml
!.streamlit/secrets.toml.example
*.bak
.env.*
!.env.example
proxy_session.json

# --- local scratch -------------------------------------------------------
reference_index/
*.xlsx
!tests/**/*.xlsx

# benchmark run scores (regenerated by score.py)
tests/benchmark/results/

tests/benchmark/*.pdf

# --- desktop build ---------------------------------------------------------
# The packaged app embeds .streamlit/secrets.toml so a teammate can run it
# without configuring anything, which means dist/ contains live Google OAuth
# credentials. It is an internal artefact and must never be committed.
build/
dist/
*.zip
